// Generado con Partitura → Arduino
// 105 notas/silencios · duración ≈ 48.0 s · 160 BPM
#include <avr/pgmspace.h>
#if !defined(PROGMEM)
  #define PROGMEM
  #define pgm_read_word(p) (*(p))
#endif

#define BUZZER 8
const uint16_t N = 105;

// Frecuencias en Hz (0 = silencio)
const uint16_t melody[] PROGMEM = {
  294, 494, 440, 392, 294, 294, 294, 294, 494, 440, 392, 330, 
  330, 523, 494, 440, 370, 0, 370, 587, 587, 523, 440, 494, 
  0, 294, 294, 494, 440, 392, 294, 0, 294, 294, 494, 440, 
  392, 330, 0, 330, 330, 523, 494, 440, 587, 587, 587, 587, 
  659, 587, 523, 440, 392, 587, 494, 494, 494, 494, 494, 494, 
  494, 587, 392, 440, 494, 523, 523, 523, 523, 523, 494, 494, 
  494, 494, 494, 440, 440, 494, 440, 587, 494, 494, 494, 494, 
  494, 494, 494, 587, 392, 440, 494, 523, 523, 523, 523, 523, 
  494, 494, 494, 494, 587, 587, 523, 440, 392
};
// Duraciones en ms
const uint16_t dur[] PROGMEM = {
  375, 375, 375, 375, 1125, 188, 188, 375, 375, 375, 375, 1500, 
  375, 375, 375, 375, 1125, 188, 188, 375, 375, 375, 375, 1125, 
  188, 188, 375, 375, 375, 375, 1125, 188, 188, 375, 375, 375, 
  375, 1125, 188, 188, 375, 375, 375, 375, 375, 375, 375, 375, 
  375, 375, 375, 375, 750, 750, 375, 375, 750, 375, 375, 750, 
  375, 375, 563, 188, 1500, 375, 375, 563, 188, 375, 375, 375, 
  188, 188, 375, 375, 375, 375, 750, 750, 375, 375, 750, 375, 
  375, 750, 375, 375, 563, 188, 1500, 375, 375, 563, 188, 375, 
  375, 375, 188, 188, 375, 375, 375, 375, 1500
};

void playSong() {
  for (uint16_t i = 0; i < N; i++) {
    uint16_t f = pgm_read_word(&melody[i]);
    uint16_t d = pgm_read_word(&dur[i]);
    if (f) tone(BUZZER, f, (uint32_t)d * 90 / 100);
    delay(d);
    noTone(BUZZER);
  }
}

void setup() {
  pinMode(BUZZER, OUTPUT);
  playSong();
}

void loop() {
}
