// Generado con Partitura → Arduino
// 144 notas/silencios · duración ≈ 185.2 s · 120 BPM
#include <avr/pgmspace.h>
#if !defined(PROGMEM)
  #define PROGMEM
  #define pgm_read_word(p) (*(p))
#endif

#define BUZZER 8
const uint16_t N = 144;

